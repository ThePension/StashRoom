{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:default",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:default",
    "os:default",
    "store:allow-load",
    "store:allow-save",
    "store:allow-get",
    "store:allow-set",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "explorer",
          "cmd": "explorer",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        },
        {
          "name": "xdg-open",
          "cmd": "xdg-open",
          "args": true
        },
        {
          "name": "gnome-terminal",
          "cmd": "gnome-terminal",
          "args": true
        },
        {
          "name": "x-terminal-emulator",
          "cmd": "x-terminal-emulator",
          "args": true
        }
      ]
    }
  ]
}
